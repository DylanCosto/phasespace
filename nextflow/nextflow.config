params {
    phasespace_container = null
}

process {
    cpus = 2
    withName: 'PHASESPACE_SCAN' {
        cpus = 4
        publishDir = [path: { "${params.outdir}/phasespace" }, mode: 'copy']
    }
}

profiles {
    docker      { docker.enabled = true }
    singularity { singularity.enabled = true; singularity.autoMounts = true }
    conda       { conda.enabled = true }
    test {
        params.samplesheet = "${projectDir}/tests/samplesheet.csv"
        params.fasta = "${projectDir}/../tests/data/hg002_chr20/GRCh38.chr20.masked.fa.gz"
        params.annotation = "${projectDir}/../tests/data/hg002_chr20/gencode.v46.gtf"
        params.outdir = "results-test"
    }
}
